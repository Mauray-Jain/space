<?xml version="1.0" encoding="utf-8"?>
<!-- Minimal on purpose (PLAN.md §7): key events, a screenshot and the browser's address bar, only when you press the key. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents|flagReportViewIds"
    android:canPerformGestures="true"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:canTakeScreenshot="true"
    android:description="@string/key_service_description"
    android:notificationTimeout="1000" />
